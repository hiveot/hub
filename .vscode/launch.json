    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "args": ["-loglevel", "info", "-home", "~/bin/hiveot", "-clientID", "owserver"]
        },
        {
            "name": "Debug Runtime", 
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/runtime/cmd/main.go",
            "cwd": "${workspaceFolder}/runtime/cmd",
            "showLog": false,
            "env": {},
            "args": ["-loglevel", "info", "-home", "~/bin/hiveot"],
            // "args": [ "-v", "-dirTD","wss://10.3.3.40:8444/.well-known/wot","status", "authn:admin"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "-tddURL", "https://10.3.3.40:8444/.well-known/wot","ld"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "ld"],
        },
        {
            "name": "Debug CLI", 
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/hubcli/main.go",
            "cwd": "${workspaceFolder}/cmd/hubcli",
            "showLog": false,
            "env": {},
            "args": ["-clientID", "admin", "-home", "~/bin/hiveot", "-timeout", "2m",  "stop","owserver"],
            // "args": ["-clientID", "admin", "-home", "~/bin/hiveot", "-timeout", "2m",  "subev"],
            // "args": ["-clientID", "admin", "-home", "~/bin/hiveot", "-timeout", "2m",  "-serverURL", "wss://10.3.3.40:8444/wot/wss", "ls"],
            // "args": [ "-v", "-dirTD","wss://10.3.3.40:8444/.well-known/wot","status", "authn:admin"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "-tddURL", "https://10.3.3.40:8444/.well-known/wot","ld"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "ld"],
                        
            // console input for login
            "console": "integratedTerminal",
        },
        {
            "name": "Debug launcher", 
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/services/launcher/cmd/main.go",
            "cwd": "${workspaceFolder}/",
            "showLog": false,
            "env": {},
            "args": ["-clientID", "launcher","-timeout","2m", "-home", "~/bin/hiveot", ],
            // "args": ["-clientID", "admin", "-home", "~/bin/hiveot", "disco"],
            // "args": [ "-v", "-dirTD","wss://10.3.3.40:8444/.well-known/wot","status", "authn:admin"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "-tddURL", "https://10.3.3.40:8444/.well-known/wot","ld"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "ld"],
        }
    ]
}