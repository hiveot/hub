    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        },
        {
            "name": "Debug Runtime", 
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/runtime/cmd/main.go",
            "cwd": "${workspaceFolder}/runtime/cmd",
            "showLog": false,
            "env": {},
            "args": ["-env"],
            // "args": [ "-v", "-dirTD","wss://10.3.3.40:8444/.well-known/wot","status", "authn:admin"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "-tddURL", "https://10.3.3.40:8444/.well-known/wot","ld"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "ld"],
        },
        {
            "name": "Debug CLI", 
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/hubcli/main.go",
            "cwd": "${workspaceFolder}/cmd/hubcli",
            "showLog": false,
            "env": {},
            "args": ["-env", "-clientID", "admin"],
            // "args": [ "-v", "-dirTD","wss://10.3.3.40:8444/.well-known/wot","status", "authn:admin"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "-tddURL", "https://10.3.3.40:8444/.well-known/wot","ld"],
            // "args": [ "-clientID", "admin", "-home","~/bin/hiveot", "ld"],
        }
    ]
}